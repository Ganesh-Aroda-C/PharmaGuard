# Pharmacovigilance Adverse Event Intake and Triage Service Configuration
# Copy this file to .env and adjust variables as needed

# Environment & Server
ENVIRONMENT=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000
SECRET_KEY=dev-secret-key-change-in-production-pv-service-2026

# Database (PostgreSQL in Docker, SQLite fallback for local development)
DATABASE_URL=sqlite:///./pv_service.db
# For Docker / PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pvuser:pvpassword@postgres:5432/pvdb

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
# In Docker:
# REDIS_URL=redis://redis:6379/0
USE_CELERY=false

# LLM Provider Configuration (deterministic_stub, ollama, openai, gemini)
LLM_PROVIDER=deterministic_stub
LLM_MODEL=pv-deterministic-v1
LLM_STUB_DELAY_SECONDS=0.1
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=15.0
LLM_MAX_RETRIES=3

# External LLM Keys (Optional - only needed if not using deterministic_stub)
OPENAI_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Circuit Breaker & Rate Limiter
CIRCUIT_BREAKER_FAILURE_THRESHOLD=3
CIRCUIT_BREAKER_RECOVERY_TIMEOUT_SECONDS=30.0
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Corpus & Vector Store
CORPUS_DIR=./corpus/documents
MANIFEST_DIR=./corpus/manifests
FAISS_INDEX_DIR=./corpus/faiss_index
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# SLO Target (D6 requirement: declared p95 end-to-end SLO)
SLO_P95_SECONDS=10.0
